# ── Modelul care GENEREAZĂ răspunsuri ────────────────────────────────
# Valori: anthropic | gemini | openai | ollama | azure | xai
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-haiku-4-5

# ── Modelul care CAUTĂ (embeddings) ──────────────────────────────────
# ⚠️ Anthropic NU are model de embeddings. Ai nevoie de un al doilea provider.
EMBEDDINGS_PROVIDER=google
GOOGLE_API_KEY=...
# Opțional; implicit gemini-embedding-001 la Google, text-embedding-3-small la OpenAI
# EMBEDDINGS_MODEL=gemini-embedding-001

# Pentru comparația de embeddings din Bloc A:
# EMBEDDINGS_PROVIDER=openai
# OPENAI_API_KEY=sk-...
